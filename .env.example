# Optional authorized profile-retrieval provider. Leave blank to use manual text.
VITE_PROFILE_ANALYSIS_API_URL=

# LinkedIn OAuth server-side settings. Add these to Vercel Project Settings > Environment Variables.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Must exactly match the Redirect URL registered in LinkedIn > Auth.
LINKEDIN_REDIRECT_URI=https://YOUR-VERCEL-DOMAIN/api/linkedin/callback
# Your deployed app's public origin, without a trailing slash.
LINKEDIN_APP_URL=https://YOUR-VERCEL-DOMAIN
# Generate a unique random value of at least 32 characters. Never use a VITE_ prefix.
LINKEDIN_OAUTH_SECRET=
